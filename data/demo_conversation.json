        "sql": "SELECT member,\nCOUNT(*) FILTER (WHERE on_time AND line_in_full AND in_a) AS num_a, COUNT(*) FILTER (WHERE in_a) AS den_a,\nCOUNT(*) FILTER (WHERE on_time AND line_in_full AND in_b) AS num_b, COUNT(*) FILTER (WHERE in_b) AS den_b\nFROM (\nSELECT supplier AS member,\n(event_date BETWEEN ? AND ?) AS in_a,\n(event_date BETWEEN ? AND ?) AS in_b,\n*\nFROM (\n\n    SELECT\n        ol.order_id,\n        o.order_date AS event_date,\n        o.dc AS dc,\n        c.emirate AS emirate,\n        c.segment AS customer_segment,\n        s.category AS category,\n        s.primary_supplier_id AS supplier,\n        (o.actual_delivery_date <= o.requested_delivery_date) AS on_time,\n        (ol.qty_delivered = ol.qty_ordered) AS line_in_full\n    FROM order_lines ol\n    JOIN orders o ON o.order_id = ol.order_id\n    JOIN customers c ON c.customer_id = o.customer_id\n    JOIN skus s ON s.sku_id = ol.sku_id\n\n) AS base\nWHERE ((event_date BETWEEN ? AND ?) OR (event_date BETWEEN ? AND ?))\n) AS tagged\nGROUP BY member",
