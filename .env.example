# Backend (FastAPI) environment. Copy to .env or export in your shell.

# Anthropic API key. Enables Stage 1 (NL -> QuerySpec) and narration.
#
# FAIL-CLOSED: POST /api/ask returns 503 if this is unset, and separately
# 503 if API_SECRET is unset — either one missing disables live questions
# entirely. GET /api/health, /api/catalog, and /api/demo all work without
# this key.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret required in the X-Api-Secret header for POST /api/ask.
# Required whenever ANTHROPIC_API_KEY is set; see the fail-closed note above.
API_SECRET=

# Allowed CORS origin(s) for the frontend, comma-separated. Required in any
# public deployment: without it, only http://localhost:3000 is allowed, and
# the server logs a startup warning.
FRONTEND_ORIGIN=https://your-frontend.example.com

# Max questions allowed per day across all callers, on top of the (locked,
# not configurable) 10-questions-per-hour-per-IP limit. Resets at UTC
# midnight.
DAILY_RUN_CAP=50

# The frontend has its own env file: see frontend/.env.example
# (NEXT_PUBLIC_API_URL and NEXT_PUBLIC_API_SECRET, which must match
# API_SECRET above).
