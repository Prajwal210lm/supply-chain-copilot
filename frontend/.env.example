# Frontend (Next.js) environment. Copy to .env.local for local dev; set the
# same variables in Vercel project settings for deploys. NEXT_PUBLIC_* values
# are inlined into the browser bundle at build time.

# Base URL of the deployed FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=https://supply-chain-copilot-production-133a.up.railway.app

# Shared secret sent as the X-Api-Secret header on POST /api/ask. Must match
# API_SECRET on the backend.
#
# This value is VISIBLE in the browser bundle by design. It exists to stop
# casual scraping, not determined attackers; the real protection is
# server-side (10 questions/hour/IP, a daily cap, and a Semaphore(1) so
# requests can't fan out into parallel paid calls).
NEXT_PUBLIC_API_SECRET=
